# python
__pycache__/
*.pyc
*.egg-info/
.venv/

# native app (C++/Qt) build products
#
# Deliberately narrow: native/tests/golden/ holds the committed golden
# vector corpus (.npy plus a reviewable manifest.json) and native/core/
# holds the *generated but committed* config.hpp, so neither may be
# swept up by a broad pattern here. Only build directories are ignored.
native/build/
native/build-*/
native/cmake-build-*/
# FetchContent's downloads (onnxruntime), kept out of the build tree so
# CI can cache them across runs without caching build output. Cache it
# whole or not at all -- see the note in .github/workflows/ci.yml.
native/.deps/
# clangd's index and the compile database it reads
compile_commands.json
.cache/

# setuptools' build tree, from `pip install .` / bdist runs
/build/

# data & training artifacts
data/
runs/

# audio/image scratch
*.wav

# Checkpoints, pictures and sweep output land in the repo root while
# working. Anything of these types that actually belongs in the repo
# lives in a subdirectory (docs/images/, data/), so these are anchored
# to the root only.
/*.pt
/*.png
/*.jpg
/*.csv
dist/
